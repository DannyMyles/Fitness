# App Configuration
NEXT_PUBLIC_APP_NAME=Marksila254
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production


# Contact details, social links, hours and page copy are managed in
# Admin → Settings (stored in the database). This is only a fallback used
# if the API is unreachable.
NEXT_PUBLIC_WHATSAPP=254701437959



# Shared mark254-commerce-api backend (also serves Source of Adventure).
# The browser only calls this site's own /api/* and /uploads/*; proxy.ts
# forwards them to BACKEND_URL and tags them X-App-Key=NEXT_PUBLIC_APP_KEY,
# which is what keeps this site's data separate from the other apps.
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_APP_KEY=fitness
# Optional. Admin screens use the signed-in admin's own token; this server-only
# key (backend: npm run app -- rotate-key --key fitness) is only a fallback.
# COMMERCE_ADMIN_KEY=


